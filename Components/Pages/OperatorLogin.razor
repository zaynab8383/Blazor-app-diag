@page "/operator/login"

@using System.Text.Json
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>ورود اپراتور</PageTitle>

<div class="operator-page">
    <div class="login-card">
        <div class="brand-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="10" rx="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                <circle cx="12" cy="16" r="1" />
            </svg>
        </div>

        <div class="login-heading">
            <h1>ورود اپراتور</h1>
            <p>برای ادامه، اطلاعات حساب خود را وارد کنید.</p>
        </div>

        <form @onsubmit="Login" @onsubmit:preventDefault>
            <div class="field-group">
                <label for="operator-username">نام کاربری</label>
                <input id="operator-username"
                       class="login-input"
                       @bind="Username"
                       autocomplete="username"
                       placeholder="نام کاربری خود را وارد کنید"
                       required />
            </div>
            <div class="field-group">
                <label for="operator-password">رمز عبور</label>

                <div class="password-field">
                    <input id="operator-password"
                           class="login-input"
                           type="@(ShowPassword ? "text" : "password")"
                           @bind="Password"
                           autocomplete="current-password"
                           placeholder="رمز عبور خود را وارد کنید"
                           required />

                    <button type="button"
                            class="password-eye"
                            @onclick="TogglePassword"
                            aria-label="@(ShowPassword ? "مخفی کردن رمز" : "نمایش رمز")"
                            title="@(ShowPassword ? "مخفی کردن رمز" : "نمایش رمز")">
                        @if (ShowPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 3l18 18" />
                                <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                                <path d="M9.9 5.2A11 11 0 0 1 12 5c5 0 8.5 4.5 9.5 7a11 11 0 0 1-3 4.2" />
                                <path d="M6.2 6.2A13 13 0 0 0 2.5 12c1 2.5 4.5 7 9.5 7a10 10 0 0 0 4-.8" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
                <button class="login-button"
                        type="submit"
                        disabled="@IsBusy">
                    @if (IsBusy)
                    {
                        <span class="loading-spinner"></span>
                        <span>در حال بررسی...</span>
                    }
                    else
                    {
                        <span>ورود به حساب</span>
                        <span class="button-arrow">→</span>
                    }
                </button>
            </div>

        </form>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="status-message @(IsError ? "status-error" : "status-success")"
                 role="status">
                <span class="status-dot"></span>
                <span>@Message</span>
            </div>
        }

        <div class="login-footer">
            <span class="footer-line"></span>
            <span>سامانهٔ مدیریت و دسترسی ریموت دیاگ</span>
            <span class="footer-line"></span>
        </div>
    </div>
</div>

<style>

    .login-heading,
    .login-heading h1,
    .login-heading p,
    .field-group label,
    .status-message,
    .remote-heading h1,
    .remote-heading p,
    .section-title h2,
    .section-title p,
    .remote-description,
    .remote-field label,
    .destination-panel,
    .dev-notice,
    .session-heading h2,
    .session-heading p,
    .session-detail span,
    .session-detail strong,
    .session-expiry,
    .session-warning,
    .remote-message,
    .checking-card h2,
    .checking-card p {
        direction: rtl;
        text-align: right;
    }

    .operator-page,
    .remote-page {
        direction: ltr;
    }


    .login-input,
    .remote-input {
        direction: rtl;
        text-align: right;
    }


    .otp-input {
        direction: ltr;
        text-align: center;
        letter-spacing: 4px;
    }

    #remote-serial {
        direction: ltr;
        text-align: left;
    }

    .operator-page {
        direction: ltr;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 18px;
        background: radial-gradient(ellipse at 15% 10%, rgba(59, 130, 246, .12), transparent 40%), radial-gradient(ellipse at 90% 90%, rgba(14, 165, 233, .10), transparent 38%), #f4f7fb;
        color: #172033;
        box-sizing: border-box;
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        box-sizing: border-box;
        padding: 38px;
        background: #fff;
        border: 1px solid #e7edf5;
        border-radius: 22px;
        box-shadow: 0 18px 55px rgba(30, 55, 90, .09);
    }

    .brand-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 17px;
    }

        .brand-icon svg {
            width: 29px;
            height: 29px;
        }

    .login-heading {
        margin-bottom: 30px;
    }

        .login-heading h1 {
            margin: 0 0 10px;
            font-size: 25px;
            font-weight: 750;
            letter-spacing: -.5px;
            color: #14213d;
        }

        .login-heading p {
            margin: 0;
            color: #718096;
            font-size: 14px;
            line-height: 1.9;
        }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 9px;
        margin-bottom: 21px;
    }

        .field-group label {
            font-size: 13px;
            font-weight: 650;
            color: #344054;
        }

    .login-input {
        width: 100%;
        min-height: 48px;
        padding: 12px 14px;
        box-sizing: border-box;
        direction: ltr;
        text-align: left;
        color: #172033;
        font: inherit;
        font-size: 14px;
        background: #fbfcfe;
        border: 1px solid #dce3ed;
        border-radius: 11px;
        outline: none;
        transition: border-color .18s, box-shadow .18s, background .18s;
    }

        .login-input::placeholder {
            color: #a0aabb;
        }

        .login-input:focus {
            background: #fff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, .12);
        }

    .login-button {
        width: 100%;
        min-height: 49px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 8px;
        padding: 12px 16px;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        border: 0;
        border-radius: 11px;
        font: inherit;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .18s, box-shadow .18s, opacity .18s;
    }

        .login-button:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, .24);
        }

        .login-button:disabled {
            opacity: .65;
            cursor: wait;
        }

    .button-arrow {
        font-size: 19px;
        line-height: 1;
    }

    .loading-spinner {
        width: 15px;
        height: 15px;
        border: 2px solid rgba(255,255,255,.45);
        border-top-color: #fff;
        border-radius: 50%;
        animation: login-spin .7s linear infinite;
    }

    .status-message {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 20px;
        padding: 13px 14px;
        border: 1px solid;
        border-radius: 11px;
        font-size: 13px;
        line-height: 1.9;
        overflow-wrap: anywhere;
    }

    .status-error {
        color: #b42318;
        background: #fff5f4;
        border-color: #fecdca;
    }

    .status-success {
        color: #067647;
        background: #ecfdf3;
        border-color: #abefc6;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        flex: 0 0 8px;
        margin-top: 8px;
        background: currentColor;
        border-radius: 50%;
    }

    .login-footer {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 31px;
        color: #98a2b3;
        font-size: 10px;
        text-align: center;
        white-space: nowrap;
    }

    .footer-line {
        height: 1px;
        flex: 1;
        background: #edf0f5;
    }

    @@keyframes login-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 480px) {
        .login-card {
            padding: 28px 22px;
            border-radius: 18px;
        }

        .login-heading h1 {
            font-size: 23px;
        }
    }

    /* فونت فارسی صفحه لاگین */
    .operator-page,
    .operator-page input,
    .operator-page button {
        font-family: "Vazirmatn", Tahoma, sans-serif;
    }

    .operator-page {
        direction: rtl;
    }

    .login-card {
        direction: rtl;
        text-align: right;
    }

    .login-heading,
    .login-heading h1,
    .login-heading p {
        direction: rtl;
        text-align: right;
    }

    .field-group label,
    .status-message {
        direction: rtl;
        text-align: right;
    }


    .login-input {
        direction: rtl;
        text-align: right;
        font-family: "Vazirmatn", Tahoma, sans-serif;
    }

    .login-button {
        font-family: "Vazirmatn", Tahoma, sans-serif;
    }

    .login-footer {
        direction: rtl;
        font-family: "Vazirmatn", Tahoma, sans-serif;
        white-space: normal;
        line-height: 1.8;
    }

    @@media (max-width: 480px) {
        .operator-page {
            padding: 20px 14px;
        }

        .login-card {
            width: 100%;
            padding: 28px 22px;
        }
    }

    .login-input {
        direction: ltr !important;
        text-align: left !important;
    }
    .password-field {
        position: relative;
        width: 100%;
    }

        .password-field .login-input {
            width: 100%;
            padding-left: 48px;
            padding-right: 14px;
            direction: ltr;
            text-align: left;
        }


    .password-eye {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        padding: 0;
        color: #98a2b3;
        background: transparent;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: color .2s ease, background .2s ease;
    }

        .password-eye svg {
            width: 19px;
            height: 19px;
        }

        .password-eye:hover {
            color: #2563eb;
            background: #eff6ff;
        }

        .password-eye:focus-visible {
            outline: 2px solid #93c5fd;
            outline-offset: 1px;
        }

    .password-field:focus-within .login-input {
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, .12);
    }

    .password-field .login-input {
        width: 100%;
        padding-left: 14px !important;
        padding-right: 48px !important;
        direction: ltr !important;
        text-align: left !important;
    }
</style>

@code {
    private string Username = "";
    private string Password = "";
    private string? Message;
    private bool IsBusy;
    private bool IsError;

    private async Task Login()
    {
        if (IsBusy)
            return;

        IsBusy = true;
        Message = null;
        IsError = false;

        try
        {
            var response = await JS.InvokeAsync<string>(
                "operatorAuth.login",
                Username.Trim(),
                Password);

            using var document = JsonDocument.Parse(response);
            var root = document.RootElement;
            var data = root.GetProperty("data");

            if (root.GetProperty("ok").GetBoolean())
            {
                Navigation.NavigateTo("/operator/remote-diagnostic", forceLoad: true);
                //Navigation.NavigateTo("/", forceLoad: true);

                return;
            }

            Message = GetMessage(data, "نام کاربری یا رمز عبور صحیح نیست.");
            IsError = true;
        }
        catch (Exception)
        {
            Message = "ارتباط با سرور برقرار نشد. اتصال را بررسی کن.";
            IsError = true;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static string GetMessage(JsonElement data, string fallback)
    {
        if (data.TryGetProperty("message", out var message) &&
            message.ValueKind == JsonValueKind.String)
        {
            return message.GetString() ?? fallback;
        }

        return fallback;
    }
    private bool ShowPassword = false;

    private void TogglePassword()
    {
        ShowPassword = !ShowPassword;
    }
}
