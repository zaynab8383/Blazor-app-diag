@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using MyBlazorApp1.Services

@implements IDisposable

@inject DiagDeviceService DiagDeviceService
@inject DiagnosticService DiagnosticService
@inject DiagnosticMenuService MenuService
@inject DiagnosticTcpServerService TcpServer


<div class="diagnostic-container">

    <!-- ========================================================= -->
    <!-- TCP SERVER HEADER -->
    <!-- ========================================================= -->

    <div class="tcp-server-panel">

        <div class="tcp-server-title">
            Diagnostic TCP Server
        </div>

        <div class="tcp-status-row">

            <div class="status-item">
                <span class="status-label">
                    Server:
                </span>

                @if (TcpServer.IsRunning)
                {
                    <span class="status-connected">
                        Running
                    </span>
                }
                else
                {
                    <span class="status-disconnected">
                        Stopped
                    </span>
                }
            </div>

            <div class="status-item">
                <span class="status-label">
                    Client:
                </span>

                @if (TcpServer.IsClientConnected)
                {
                    <span class="status-connected">
                        Connected
                    </span>
                }
                else
                {
                    <span class="status-disconnected">
                        Disconnected
                    </span>
                }
            </div>

            @if (TcpServer.IsClientConnected)
            {
                <div class="status-item">

                    <span class="status-label">
                        Endpoint:
                    </span>

                    <span class="endpoint">
                        @TcpServer.ClientEndPoint
                    </span>

                </div>
            }

        </div>

        <div class="tcp-buttons">

            @if (!TcpServer.IsRunning)
            {
                <button type="button"
                        class="tcp-button start-button"
                        @onclick="StartTcpServer">

                    Start TCP Server

                </button>
            }
            else
            {
                <button type="button"
                        class="tcp-button stop-button"
                        @onclick="StopTcpServer">

                    Stop TCP Server

                </button>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- KEYBOARD -->
    <!-- ========================================================= -->
   


    @if (MenuService.State.Keyboard.Visible)
    {
        <div class="keyboard-panel">

            <h2>
                @MenuService.State.Keyboard.Header
            </h2>

            <input class="keyboard-input"
                   type="@(MenuService.State.Keyboard.Type == 13 ? "password" : "text")"
                   value="@MenuService.State.Keyboard.Value"
                   @oninput="KeyboardInputChanged"
                   autofocus />

            <div class="keyboard-actions">

                <button type="button"
                        class="keyboard-action"
                        @onclick="KeyboardCancel">

                    CANCEL

                </button>

                <button type="button"
                        class="keyboard-action enter-button"
                        @onclick="KeyboardEnter">

                    ENTER

                </button>

            </div>

        </div>
    }



    <!-- ========================================================= -->
    <!-- BOX PAGE -->
    <!-- ========================================================= -->
    @if (MenuService.State.Screen == MenuScreen.BoxPage)
    {
        <div class="diagnostic-panel">

            <h3>
                @MenuService.State.Header
            </h3>

            @foreach (var item in MenuService.State.Items)
            {
                <button type="button"
                        class="diagnostic-button"
                        @onclick="() => SelectMenuItem(item)">

                    @item.Text

                </button>
            }

        </div>
    }


    <!-- ========================================================= -->
    <!-- SOFTWARE LIST -->
    <!-- ========================================================= -->
    @* @if (MenuService.State.Screen == MenuScreen.SoftwareList)
    {
        <div class="software-page">

            <div class="software-header">
                @MenuService.State.Header
            </div>

            <div class="software-content">

                @foreach (var item in MenuService.State.Items)
                {
                    <div class="software-row">
                        @item.Text
                    </div>
                }

            </div>

        </div>
    } *@



    @if (MenuService.State.Screen == MenuScreen.SoftwareList)
    {
        <div class="software-page">

            <div class="software-header">
                @MenuService.State.Header
            </div>

            <div class="software-content">

                @foreach (var item in MenuService.GetCurrentSoftwarePageItems())
                {
                    <button type="button"
                            class="software-row @(item.Selected ? "software-row-selected" : "")"
                            @onclick="() => SelectSoftwareItem(item)">

                        <span class="software-index">
                            @item.Index
                        </span>

                        <span class="software-name">
                            @item.Text
                        </span>

                    </button>
                }

            </div>

            <div class="software-navigation">

                <button type="button"
                        class="software-nav-button"
                        @onclick="SoftwarePageUp"
                        disabled="@(MenuService.State.SoftwarePage == 0)">
                    UP
                </button>

                <div class="software-page-number">
                    Page @(MenuService.State.SoftwarePage + 1)
                    /
                    @MenuService.GetSoftwarePageCount()
                </div>

                <button type="button"
                        class="software-nav-button"
                        @onclick="SoftwarePageDown"
                        disabled="@(MenuService.State.SoftwarePage >= MenuService.GetSoftwarePageCount() - 1)">
                    DOWN
                </button>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- MESSAGE -->
    <!-- ========================================================= -->
    @if (MenuService.State.Screen == MenuScreen.Message)
    {
        <div class="diagnostic-panel">

            <h3>
                @MenuService.State.Header
            </h3>

            <div class="message-box">
                @MenuService.State.Message
            </div>

            <button type="button"
                    class="diagnostic-button"
                    @onclick="ContinueMessage">

                ادامه

            </button>

        </div>
    }



    <!-- ========================================================= -->
    <!-- MEMO -->
    <!-- ========================================================= -->
    @if (MenuService.State.Screen == MenuScreen.Memo)
    {
        <div class="memo-page">

            <h2>
                @MenuService.State.Header
            </h2>

            @foreach (var record in MenuService.State.MemoRecords)
            {
                <div class="memo-record">

                    <div class="memo-title">
                        @record.Title
                    </div>

                    @foreach (var line in record.Lines)
                    {
                        <div class="memo-line">
                            @line
                        </div>
                    }

                </div>
            }

        </div>
    }


    <!-- ========================================================= -->
    <!-- SELECT PAGE -->
    <!-- ========================================================= -->

    @if (MenuService.State.Screen == MenuScreen.SelectPage)
    {
        <div class="diagnostic-panel">

            <h3>
                @MenuService.State.Header
            </h3>

            @foreach (var item in MenuService.State.Items)
            {
                <div class="checkbox-row">

                    <input type="checkbox"
                           checked="@item.Checked"
                           @onchange="e => SetCheckBox(
                                               item.Index,
                                               e.Value is bool checkedValue && checkedValue)" />

<span>
                        @item.Text
                    </span>

                </div>
            }

            <button type="button"
                    class="diagnostic-button"
                    @onclick="ConfirmParameterSelection">

                OK

            </button>

        </div>
    }




    @if (MenuService.State.Screen == MenuScreen.Parameters)
    {
        <div class="parameters-page">

            <div class="parameters-header">
                @MenuService.State.Header
            </div>

            <div class="parameter-navigation">

                <button type="button"
                        class="parameter-nav-button"
                        @onclick="ParameterUp">

                    UP

                </button>

                <button type="button"
                        class="parameter-nav-button"
                        @onclick="ParameterDown">

                    DOWN

                </button>

            </div>

            <div class="parameters-table-wrapper">

                <table class="parameters-table">

                    <thead>

                        <tr>
                            <th>#</th>
                            <th>Parameter</th>
                            <th>Description</th>
                            <th>Unit</th>
                            <th>Value</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var parameter in MenuService.State.Parameters)
                        {
                            <tr class="@(parameter.IsActive
                                                                                    ? "parameter-active"
                                                                                    : "parameter-inactive")">

                                <td>
                                    @parameter.Index
                                </td>

                                <td>
                                    @parameter.Col0
                                </td>

                                <td>
                                    @parameter.Col1
                                </td>

                                <td>
                                    @parameter.Col2
                                </td>

                                <td class="parameter-value">
                                    @parameter.CurrentValue
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }



    <!-- ========================================================= -->
    <!-- SENSOR -->
    <!-- ========================================================= -->
    @if (MenuService.State.Screen == MenuScreen.Sensor)
    {
        <div class="diagnostic-panel">

            <h3>
                @MenuService.State.Header
            </h3>

            <table class="sensor-table">

                <thead>

                    <tr>
                        <th>#</th>
                        <th>Value</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var parameter in MenuService.State.Parameters)
                    {
                        <tr class="@(parameter.IsActive
                                                        ? "sensor-active"
                                                        : "sensor-inactive")">

                            <td>
                                @parameter.Index
                            </td>

                            <td class="sensor-value">
                                @parameter.CurrentValue
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            @if (MenuService.State.Items.Count > 0)
            {
                <div class="sensor-buttons">

                    @foreach (var item in MenuService.State.Items)
                    {
                        <button type="button"
                                class="diagnostic-button"
                                @onclick="() => SelectSensorItem(item.Index)">

                            @item.Text

                        </button>
                    }

                </div>
            }

        </div>
    }

    <!-- ========================================================= -->
    <!-- BACK -->
    <!-- ========================================================= -->

    @* <div class="back-container"
         style="@(MenuService.State.Screen != MenuScreen.None
                        ? "visibility: visible;"
                        : "visibility: hidden;")">

        <button type="button"
                class="diagnostic-button back-button"
                @onclick="Back">

            Back

        </button>

    </div> *@

  @*   <div class="back-container"
         style="@(
         MenuService.State.Keyboard.Visible &&
         (MenuService.State.Keyboard.Type == 10 ||
          MenuService.State.Keyboard.Type == 11 ||
          MenuService.State.Keyboard.Type == 12 ||
          MenuService.State.Keyboard.Type == 13)
             ? "visibility: hidden;"
             : "visibility: visible;"
         )">

        <button type="button"
                class="diagnostic-button back-button"
                @onclick="Back">

            Back

        </button>

    </div> *@

    @if (MenuService.State.Screen != MenuScreen.None &&
    !MenuService.State.Keyboard.Visible &&
    MenuService.State.Screen != MenuScreen.Message)
    {
        <div class="back-container">
            <button type="button"
                    class="diagnostic-button back-button"
                    @onclick="Back">
                Back
            </button>
        </div>
    }

</div>


