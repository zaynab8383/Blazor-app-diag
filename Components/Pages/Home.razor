private void KeyboardEnter()
{
    Console.WriteLine("========== KEYBOARD ENTER ==========");

    string value = MenuService.State.Keyboard.Value;

    Console.WriteLine($"VALUE = [{value}]");

    byte[] data =
        System.Text.Encoding.UTF8.GetBytes(value + "\r\n");

    Console.WriteLine("SENDING VALUE...");

    SerialService.Send(data);

    Console.WriteLine("SEND FINISHED");

    StateHasChanged();
}
private string[] Ports = Array.Empty<string>();

private string SelectedPort = "";

private int BaudRate = 9600;

private string Status = "Disconnected";

private string ReceivedData = "";

private string DiagnosticMessage = "";

private string DiagnosticType = "";

protected override void OnInitialized()
{
    Ports = SerialService.GetPorts();

    if (Ports.Length > 0)
    {
        SelectedPort = Ports[0];
    }

    SerialService.DataReceived += OnSerialDataReceived;

    DiagnosticService.MessageReceived +=
        OnDiagnosticMessageReceived;

    DiagnosticService.DiagnosticDataReceived +=
        OnDiagnosticDataReceived;

    MenuService.StateChanged +=
        OnMenuStateChanged;

    DiagnosticService.Start();
}

private void OnSerialDataReceived(string data)
{
    _ = InvokeAsync(() =>
    {
        ReceivedData = data;

        StateHasChanged();
    });
}

private void OnDiagnosticMessageReceived(string message)
{
    _ = InvokeAsync(() =>
    {
        DiagnosticMessage = message;

        StateHasChanged();
    });
}

private void OnDiagnosticDataReceived(string[] data)
{
    _ = InvokeAsync(() =>
    {
        if (data.Length > 1)
        {
            DiagnosticType = data[1];
        }

        StateHasChanged();
    });
}

private void OnMenuStateChanged()
{
    _ = InvokeAsync(() =>
    {
        StateHasChanged();
    });
}

private void Connect()
{
    try
    {
        if (string.IsNullOrWhiteSpace(SelectedPort))
        {
            Status = "No COM port selected";
            return;
        }

        SerialService.Connect(
            SelectedPort,
            BaudRate);

        Status =
            $"Connected to {SelectedPort}";

        StateHasChanged();
    }
    catch (Exception ex)
    {
        Status =
            $"Error: {ex.Message}";

        StateHasChanged();
    }
}

private void Disconnect()
{
    SerialService.Disconnect();

    Status = "Disconnected";

    StateHasChanged();
}

private void SelectMenuItem(int index)
{
    MenuService.SelectMenuItem(index);
}

private void SelectSensorItem(int index)
{
    MenuService.SelectSensorItem(index);
}

private void SetCheckBox(
    int index,
    bool value)
{
    MenuService.SetCheckBox(
        index,
        value);
}

private void ContinueMessage()
{
    MenuService.ContinueMessage();
}

private void Back()
{
    MenuService.Back();
}

public void Dispose()
{
    SerialService.DataReceived -=
        OnSerialDataReceived;

    DiagnosticService.MessageReceived -=
        OnDiagnosticMessageReceived;

    DiagnosticService.DiagnosticDataReceived -=
        OnDiagnosticDataReceived;

    MenuService.StateChanged -=
        OnMenuStateChanged;

    DiagnosticService.Stop();
}
}