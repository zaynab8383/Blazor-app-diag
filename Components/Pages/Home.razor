    //     }
    //     catch (Exception ex)
    //     {
    //         Console.WriteLine(
    //             $"SelectMenuItem ERROR: {ex}");
    //     }
    // }


    private async Task SelectMenuItem(MenuItem item)
    {
        try
        {
            string command = item.Command;

            /*
             * If for some reason the command
             * is empty, fall back to Index.
             */
            if (string.IsNullOrWhiteSpace(command))
            {
                command = item.Index.ToString();
            }

            Console.WriteLine();
            Console.WriteLine(
                "========== UI MENU COMMAND ==========");

            Console.WriteLine(
                $"INDEX = [{item.Index}]");

            Console.WriteLine(
                $"COMMAND = [{command}]");

            Console.WriteLine(
                $"TEXT = [{item.Text}]");

            await DiagnosticService.SendAsync(command);

            Console.WriteLine(
                $"UI -> MENU COMMAND SENT: [{command}]");

            Console.WriteLine(
                "=====================================");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"SelectMenuItem ERROR: {ex}");
        }
    }



    /* ========================================================= */
    /* SENSOR */
    /* ========================================================= */

    private async Task SelectSensorItem(int index)
    {
        try
        {
            string command = index.ToString();

            Console.WriteLine();
            Console.WriteLine(
                "========= UI SENSOR COMMAND =========");

            Console.WriteLine(
                $"COMMAND = [{command}]");

            await DiagnosticService.SendAsync(command);

            Console.WriteLine(
                $"UI -> SENSOR COMMAND SENT: [{command}]");

            Console.WriteLine(
                "=====================================");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"SelectSensorItem ERROR: {ex}");
        }
    }


    /* ========================================================= */
    /* CHECKBOX */
    /* ========================================================= */

    private async Task SetCheckBox(int index, bool value)
    {
        try
        {
            string command =
                $"{index},{(value ? 1 : 0)}";

            Console.WriteLine();
            Console.WriteLine(
                "========= UI CHECKBOX COMMAND ========");

            Console.WriteLine(
                $"COMMAND = [{command}]");

            await DiagnosticService.SendAsync(command);

            Console.WriteLine(
                $"UI -> CHECKBOX COMMAND SENT: [{command}]");

            Console.WriteLine(
                "=====================================");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"SetCheckBox ERROR: {ex}");
        }
    }


