@code
{
    private void SoftwarePageUp()
    {
        MenuService.SoftwarePageUp();
    }

    private void SoftwarePageDown()
    {
        MenuService.SoftwarePageDown();
    }

    private async Task SelectSoftwareItem(MenuItem item)
    {
        try
        {
            Console.WriteLine();
            Console.WriteLine("========== FILE SELECT ==========");
            Console.WriteLine($"INDEX = [{item.Index}]");
            Console.WriteLine($"FILE = [{item.Text}]");
            Console.WriteLine("=================================");

            foreach (var file in MenuService.State.Items)
            {
                file.Selected = file.Index == item.Index;
            }

            MenuService.State.SelectedIndex = item.Index;



            int commandIndex = item.Index % MenuState.SoftwarePageSize;

            await DiagnosticService.SendAsync(
                commandIndex.ToString());


            Console.WriteLine(
                $"UI -> FILE INDEX SENT: [{item.Index}]");

            Console.WriteLine(
                "=================================");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"SelectSoftwareItem ERROR: {ex}");
        }
    }

    /* ========================================================= */
    /* TCP SERVER */
    /* ========================================================= */

    private async Task StartTcpServer()
    {
        try
        {
            Console.WriteLine();
            Console.WriteLine(
                "========== HOME: START TCP ==========");

            if (!TcpServer.IsRunning)
            {
                await TcpServer.StartAsync(9000);

                Console.WriteLine(
                    "TCP Server started from Home.");
            }

            if (!DiagnosticService.IsRunning)
            {
                DiagnosticService.Start();

                Console.WriteLine(
                    "DiagnosticService started from Home.");
            }

            Console.WriteLine(
                "=====================================");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"TCP SERVER START ERROR: {ex}");
        }

        await InvokeAsync(StateHasChanged);
    }


    private async Task StopTcpServer()
    {
        try
        {
            Console.WriteLine();
            Console.WriteLine(
                "========== HOME: STOP TCP ==========");

            DiagnosticService.Stop();
            TcpServer.Stop();

            Console.WriteLine(
                "TCP Server stopped from Home.");

            Console.WriteLine(
                "===================================");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"TCP SERVER STOP ERROR: {ex}");
        }

        await InvokeAsync(StateHasChanged);
    }


    /* ========================================================= */
    /* INITIALIZATION */
    /* ========================================================= */

    protected override async Task OnInitializedAsync()
    {
        DiagnosticService.MessageReceived +=
            OnDiagnosticMessageReceived;

        DiagnosticService.DiagnosticDataReceived +=
            OnDiagnosticDataReceived;

        MenuService.StateChanged +=
            OnMenuStateChanged;

        TcpServer.LogReceived +=
            OnTcpLogReceived;

        try
        {
            if (!TcpServer.IsRunning)
            {
                await TcpServer.StartAsync(9000);

                Console.WriteLine(
                    "TCP Server started automatically from Home.");
            }

            if (!DiagnosticService.IsRunning)
            {
                DiagnosticService.Start();

                Console.WriteLine(
                    "DiagnosticService started automatically.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"TCP INITIALIZATION ERROR: {ex}");
        }

        await InvokeAsync(StateHasChanged);
    }


    /* ========================================================= */
    /* EVENTS */
    /* ========================================================= */

    private void OnTcpLogReceived(string message)
    {
        _ = InvokeAsync(StateHasChanged);
    }


    private void OnDiagnosticMessageReceived(string message)
    {
        Console.WriteLine(
            $"HOME <- DIAGNOSTIC MESSAGE ({message.Length} chars)");

        _ = InvokeAsync(StateHasChanged);
    }


    private void OnDiagnosticDataReceived(string[] data)
    {
        string type =
            data != null && data.Length > 1
                ? data[1]
                : "UNKNOWN";

        Console.WriteLine(
            $"HOME <- DIAGNOSTIC DATA Type=[{type}]");

        _ = InvokeAsync(StateHasChanged);
    }


    private void OnMenuStateChanged()
    {
        Console.WriteLine(
            $"HOME <- MENU STATE CHANGED " +
            $"Screen={MenuService.State.Screen}");

        _ = InvokeAsync(StateHasChanged);
    }


