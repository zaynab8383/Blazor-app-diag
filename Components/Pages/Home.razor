    private async Task KeyboardInputChanged(ChangeEventArgs e)
    {
        try
        {
            string value =
                e.Value?.ToString() ?? "";

            int type =
                MenuService.State.Keyboard.Type;

            MenuService.State.Keyboard.Value = value;

            Console.WriteLine();
            Console.WriteLine("========== KEYBOARD INPUT ==========");
            Console.WriteLine($"TYPE  = [{type}]");
            Console.WriteLine($"VALUE = [{value}]");

            await DiagnosticService.SendAsync(value);

            Console.WriteLine(
                $"UI -> KEYBOARD INPUT SENT: [{value}]");

            Console.WriteLine(
                "===================================");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"KEYBOARD INPUT ERROR: {ex}");
        }
    }


