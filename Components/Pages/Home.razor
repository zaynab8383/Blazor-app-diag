@page "/"
@rendermode InteractiveServer

@using MyBlazorApp1.Services
@using System.Text

@implements IDisposable

@inject MyBlazorApp1.Services.SerialService SerialService
@inject MyBlazorApp1.Services.DiagnosticService DiagnosticService
@inject MyBlazorApp1.Services.DiagnosticMenuService MenuService

<h1>Diagnostic Bridge</h1>

<hr />

<h3>Serial Connection</h3>

<div style="margin-bottom: 10px;">

<label>COM Port:</label>

<select @bind="SelectedPort">
    @foreach (var port in Ports)
    {
        <option value="@port">@port</option>
    }
</select>

<label style="margin-left: 15px;">Baud Rate:</label>

<input type="number"
       @bind="BaudRate"
       style="width:100px;" />

<button @onclick="Connect"
        style="margin-left:15px;">
    Connect
</button>

<button @onclick="Disconnect"
        style="margin-left:5px;">
    Disconnect
</button>
</div>

<p> <strong>Status:</strong> @Status </p>

<hr />

<h3>Received Data</h3>

<div style=" background:#111; color:#00ff00; padding:10px; min-height:80px; white-space:pre-wrap; font-family:monospace;"> @ReceivedData </div>

<hr />

<h3>Diagnostic Message</h3>

<div style=" background:#f5f5f5; border:1px solid #ccc; padding:15px; min-height:80px; white-space:pre-wrap;"> @DiagnosticMessage </div>

<p> <strong>Type:</strong> @DiagnosticType </p>

<hr />

@if (MenuService.State.Keyboard.Visible)
{
<div class="keyboard-panel">

    <h2>
        @MenuService.State.Keyboard.Header
    </h2>

    <input class="keyboard-input"
           @bind="MenuService.State.Keyboard.Value"
           readonly />

    @if (MenuService.State.Keyboard.Mode == "Letters")
    {
        <div class="keyboard-grid">

            @foreach (var key in LetterKeys)
            {
                <button class="key-button"
                        @onclick="() => KeyboardKey(key)">
                    @key
                </button>
            }

        </div>
    }

    @if (MenuService.State.Keyboard.Mode == "Numbers")
    {
        <div class="keyboard-grid">

            @foreach (var key in NumberKeys)
            {
                <button class="key-button"
                        @onclick="() => KeyboardKey(key)">
                    @key
                </button>
            }

        </div>
    }

    @if (MenuService.State.Keyboard.Mode == "Characters")
    {
        <div class="keyboard-grid">

            @foreach (var key in CharacterKeys)
            {
                <button class="key-button"
                        @onclick="() => KeyboardKey(key)">
                    @key
                </button>
            }

        </div>
    }

    <div class="keyboard-actions">

        <button class="keyboard-action"
                @onclick="KeyboardNumbers">
            123
        </button>

        <button class="keyboard-action"
                @onclick="KeyboardCharacters">
            کاراکترها
        </button>

        <button class="keyboard-action"
                @onclick="KeyboardDelete">
            DEL
        </button>

        <button class="keyboard-action"
                @onclick="KeyboardCancel">
            CANCEL
        </button>

        <button class="keyboard-action enter-button"
                @onclick="KeyboardEnter">
            ENTER
        </button>

    </div>

</div>
}

@if (MenuService.State.Screen == MenuScreen.BoxPage)
{
<div class="diagnostic-panel">

    <h3>@MenuService.State.Header</h3>

    @foreach (var item in MenuService.State.Items)
    {
        <button class="diagnostic-button"
                @onclick="() => SelectMenuItem(item.Index)">

            @item.Text

        </button>
    }

</div>
}



@if (MenuService.State.Screen == MenuScreen.SoftwareList)
{
    <div class="software-page">

        <div class="software-header">
            @MenuService.State.Header
        </div>

        <div class="software-content">

            @foreach (var item in MenuService.State.Items)
            {
                <div class="software-row">
                    @item.Text
                </div>
            }

        </div>

    </div>
}


@if (MenuService.State.Screen == MenuScreen.Message)
{
<div class="diagnostic-panel">

    <h3>@MenuService.State.Header</h3>

    <div style="
        padding:20px;
        border:1px solid #ccc;
        margin-bottom:15px;
        white-space:pre-wrap;">

        @MenuService.State.Message

    </div>

    <button class="diagnostic-button"
            @onclick="ContinueMessage">

        ادامه

    </button>

</div>
}

