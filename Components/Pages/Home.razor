    private async Task KeyboardCancel()
    {
        try
        {
            Console.WriteLine();
            Console.WriteLine("========== KEYBOARD CANCEL ==========");

            // -2 -2 -2
            await DiagnosticService.SendAsync("-2-2-2");
            Console.WriteLine("UI -> CANCEL COMMANDS SENT: [-2-2-2]");
            Console.WriteLine("=====================================");

            // خروج از صفحه Keyboard
            // MenuService.State.Keyboard.Visible = false;

            // await InvokeAsync(StateHasChanged);
            MenuService.State.Keyboard.Visible = false;

            MenuService.State.Screen =
                MenuService.State.Keyboard.PreviousScreen;

            await InvokeAsync(StateHasChanged);


        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"KEYBOARD CANCEL ERROR: {ex}");

            MenuService.State.Keyboard.Visible = false;

            await InvokeAsync(StateHasChanged);
        }
    }


