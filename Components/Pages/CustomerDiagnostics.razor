        await LoadDevicesAsync();
    }

    private void OnCustomerMenuStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadDevicesAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Customer"))
            {
                errorMessage = "برای مشاهدهٔ دیاگ‌ها ابتدا وارد حساب مشتری شوید.";
                return;
            }

            var phone = user.FindFirst(ClaimTypes.MobilePhone)?.Value;

            if (string.IsNullOrWhiteSpace(phone))
            {
                errorMessage = "شماره تلفن در اطلاعات ورود پیدا نشد.";
                return;
            }

            var result = await CustomerDiagnosticService.GetForPhoneAsync(phone);

            devices = result.ToList();

            if (selectedDevice is not null)
            {
                selectedDevice = devices.FirstOrDefault(
                    d => d.SerialNumber == selectedDevice.SerialNumber);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Customer diagnostics page error: {ex}");

            errorMessage = "دریافت فهرست دیاگ‌ها ناموفق بود.";
        }
        finally
        {
            loading = false;
        }
    }


    private async Task SelectDevice(CustomerDiagnosticDto device)
    {
        errorMessage = null;

        try
        {
            var onlineDevice =
                DiscoveryService.GetOnlineDeviceBySerialNumber(
                    device.SerialNumber);

            if (onlineDevice is null)
            {
                errorMessage =
                    "اتصال دیاگ برقرار نیست یا شناسایی آن کامل نشده است.";
                return;
            }

            // DiagnosticService.SelectConnection(
            //     onlineDevice.ConnectionId);

            // DiagnosticService.Start();

            // selectedDevice = device;
            // selectedConnectionId = onlineDevice.ConnectionId;

            // Navigation.NavigateTo("/");
            // ذخیره شماره سریال برای بازیابی انتخاب بعد از رفرش مرورگر
            await JS.InvokeVoidAsync(
                "diagnosticSelection.saveSerial",
                device.SerialNumber);

            DiagnosticService.SelectConnection(
                onlineDevice.ConnectionId);

            DiagnosticService.Start();

            selectedDevice = device;
            selectedConnectionId = onlineDevice.ConnectionId;

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Select diagnostic failed: {ex}");

            errorMessage =
                $"انتخاب دیاگ ناموفق بود: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

