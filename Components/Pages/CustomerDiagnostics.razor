@page "/customer/diagnostics"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Customer")]
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MyBlazorApp1.Services
@using System

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CustomerDiagnosticService CustomerDiagnosticService
@inject OnlineDiagnosticDiscoveryService DiscoveryService
@inject DiagnosticTcpServerService TcpServer
@inject NavigationManager Navigation
@inject DiagnosticService DiagnosticService
@inject DiagnosticMenuService MenuService
@inject IJSRuntime JS

<PageTitle>دیاگ‌های من</PageTitle>

<h3>دیاگ‌های من</h3>

@if (loading)
{
    <p>در حال دریافت فهرست دیاگ‌ها...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p role="alert">@errorMessage</p>
    <button class="btn btn-primary" @onclick="LoadDevicesAsync">
        تلاش مجدد
    </button>
}
else if (devices.Count == 0)
{
    <p>هیچ دیاگی برای این حساب ثبت نشده است.</p>
}
else
{
    <p>تعداد دیاگ‌های شما: @devices.Count</p>

    <div class="row">
        @foreach (var device in devices)
        {
            <div class="col-12 col-md-6 mb-3" @key="device.SerialNumber">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            دیاگ @device.SerialNumber
                        </h5>

                        <p>
                            وضعیت:
                            @if (device.IsOnline)
                            {
                                <span class="text-success fw-bold">آنلاین</span>
                            }
                            else
                            {
                                <span class="text-secondary fw-bold">آفلاین</span>
                            }
                        </p>

                        @if (device.IsOnline)
                        {
                            <p>نسخه نرم‌افزار: @device.SoftwareVersion</p>
                            <p>شمارنده: @device.Counter</p>

                            <button class="btn btn-primary"
                                    @onclick="() => SelectDevice(device)">
                                انتخاب دیاگ
                            </button>
                        }
                        else
                        {
                            <p>برای اتصال، ابتدا دیاگ را آنلاین کنید.</p>
                            <button class="btn btn-secondary" disabled>
                                انتخاب دیاگ
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <button class="btn btn-outline-primary" @onclick="LoadDevicesAsync">
        به‌روزرسانی وضعیت
    </button>

    @if (selectedDevice is not null)
    {
        <hr />
        <p>
            دیاگ انتخاب‌شده:
            <strong>@selectedDevice.SerialNumber</strong>
        </p>
        @if (!string.IsNullOrWhiteSpace(selectedConnectionId))
        {
            <p class="text-success">
                اتصال فعال دیاگ انتخاب شد.
            </p>
        }
    
        <hr />
        <h4>منوی دیاگ @selectedDevice.SerialNumber</h4>
        <p>اتصال انتخاب‌شده: @selectedConnectionId</p>
        
        @if (_customerMenuService is not null)
        {
            var menu = _customerMenuService.State;

            <hr />
            <h5>@menu.Header</h5>

            @switch (menu.Screen)
            {
                case MenuScreen.BoxPage:
                case MenuScreen.SelectPage:
                case MenuScreen.SoftwareList:
                    @foreach (var item in menu.Items)
                    {
                        <button class="btn btn-outline-primary d-block mb-2"
                                @key="item.Index"
                                @onclick="() => _customerMenuService.SelectMenuItem(item.Index)">
                            @item.Text
                        </button>
                    }
                    break;

                case MenuScreen.Message:
                    <p>@menu.Message</p>
                    <button class="btn btn-primary"
                            @onclick="_customerMenuService.ContinueMessage">
                        ادامه
                    </button>
                    break;

                case MenuScreen.Memo:
                    @foreach (var memo in menu.MemoRecords)
                    {
                        <h6>@memo.Title</h6>
                        @foreach (var line in memo.Lines)
                        {
                            <p>@line</p>
                        }
                    }
                    break;

                case MenuScreen.Parameters:
                    @foreach (var parameter in menu.Parameters)
                    {
                        <p>
                            @parameter.Name:
                            @(parameter.IsActive ? parameter.CurrentValue : "^^^^")
                        </p>
                    }
                    break;

                case MenuScreen.Sensor:
                    @foreach (var sensor in menu.Sensors)
                    {
                        <p>@sensor.Name: @sensor.CurrentValue</p>
                    }

                    @foreach (var action in menu.SensorActions)
                    {
                        <button class="btn btn-outline-primary me-2 mb-2"
                                @key="action.Index"
                                @onclick="() => _customerMenuService.SelectSensorItem(action.Index)">
                            @action.Text
                        </button>
                    }
                    break;

                case MenuScreen.Type10:
                case MenuScreen.Type11:
                case MenuScreen.Type12:
                case MenuScreen.Type13:
                    <p>@menu.Keyboard.Header</p>
                    <p>@menu.Keyboard.Value</p>
                    break;
            }

            @if (menu.Screen != MenuScreen.None)
            {
                <button class="btn btn-secondary mt-2"
                        @onclick="_customerMenuService.Back">
                    بازگشت
                </button>
            }
        }
    }
}

