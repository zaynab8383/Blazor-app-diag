<PageTitle>دسترسی ریموت دیاگ</PageTitle>

<div class="remote-page">
    <div class="remote-shell">
        <header class="remote-header">
            <div class="remote-heading">
                <div class="remote-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="13" rx="2" />
                        <path d="M8 21h8M12 17v4M8 10l2.5 2.5L16 7" />
                    </svg>
                </div>
                <div>
                    <h1>دسترسی ریموت دیاگ</h1>
                    <p>مدیریت دسترسی اپراتور به دستگاه</p>
                </div>
            </div>

            <div class="remote-badge">
                <span class="remote-badge-dot"></span>
                پنل اپراتور
            </div>
        </header>

        @if (IsChecking)
        {
            <section class="remote-card checking-card">
                <span class="remote-spinner"></span>
                <h2>در حال بررسی دسترسی</h2>
                <p>لطفاً تا تکمیل بررسی صبر کنید.</p>
            </section>
        }
        else if (IsAuthenticated)
        {
            <section class="remote-card">
                <div class="section-title">
                    <span class="step-number">۱</span>
                    <div>
                        <h2>شناسایی دستگاه</h2>
                        <p>شماره سریال دستگاه را وارد کنید.</p>
                    </div>
                </div>

                <p class="remote-description">
                    کد تأیید برای شماره مالک ثبت‌شده در سامانه ارسال خواهد شد.
                </p>

                <form @onsubmit="RequestOtp" @onsubmit:preventDefault>
                    <div class="remote-field">
                        <label for="remote-serial">شماره سریال دستگاه</label>
                        <input id="remote-serial"
                               class="remote-input"
                               @bind="SerialNumber"
                               autocomplete="off"
                               placeholder="شماره سریال را وارد کنید"
                               required />
                    </div>

                    <button class="remote-button primary-button"
                            type="submit"
                            disabled="@IsBusy">
                        @if (IsBusy)
                        {
                            <span class="remote-spinner small-spinner"></span>
                            <span>در حال ارسال درخواست...</span>
                        }
                        else
                        {
                            <span>درخواست کد تأیید</span>
                            <span>→</span>
                        }
                    </button>
                </form>

                @if (OtpRequested)
                {
                    <div class="section-divider"></div>

                    <div class="section-title">
                        <span class="step-number">۲</span>
                        <div>
                            <h2>تأیید مالکیت</h2>
                            <p>کد ارسال‌شده را وارد کنید.</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(MaskedPhone))
                    {
                        <div class="destination-panel">
                            <span class="destination-label">شماره مقصد</span>
                            <strong>@MaskedPhone</strong>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(DevelopmentOtp))
                    {
                        <div class="dev-notice">
                            <strong>کد آزمایشی محیط توسعه</strong>
                            <div class="dev-code">@DevelopmentOtp</div>
                            <small>این کد از طریق پیامک ارسال نشده است.</small>
                        </div>
                    }

                    <form @onsubmit="VerifyOtp" @onsubmit:preventDefault>
                        <div class="remote-field">
                            <label for="remote-otp">کد تأیید</label>
                            <input id="remote-otp"
                                   class="remote-input otp-input"
                                   @bind="Code"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   maxlength="6"
                                   placeholder="کد تأیید را وارد کنید"
                                   required />
                        </div>

                        <button class="remote-button success-button"
                                type="submit"
                                disabled="@IsBusy">
                            @if (IsBusy)
                            {
                                <span class="remote-spinner small-spinner"></span>
                                <span>در حال بررسی...</span>
                            }
                            else
                            {
                                <span>تأیید کد و ایجاد نشست</span>
                            }
                        </button>
                    </form>
                }
            </section>

            @if (SessionReady)
            {
                <section class="session-card">
                    <div class="session-heading">
                        <div class="session-check">✓</div>
                        <div>
                            <h2>نشست ریموت ایجاد شد</h2>
                            <p>اطلاعات نشست تأیید شده است.</p>
                        </div>
                    </div>

                    <div class="session-details">
                        <div class="session-detail">
                            <span>شماره سریال</span>
                            <strong>@SessionSerial</strong>
                        </div>
                        <div class="session-detail">
                            <span>انقضا (UTC)</span>
                            <strong>@SessionExpiresAt</strong>
                        </div>
                    </div>

                    <div class="session-expiry">
                        این نشست برای حداکثر ۳۰ دقیقه ایجاد شده است.
                    </div>

                    <p class="session-warning">
                        برای جلوگیری از ارسال فرمان بدون کنترل دسترسی،
                        اتصال این نشست به صفحهٔ عملیاتی دیاگ باید در مرحلهٔ بعد تکمیل شود.
                    </p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="remote-message @(IsError ? "remote-error" : "remote-info")"
                     role="status">
                    <span class="message-indicator"></span>
                    <span>@Message</span>
                </div>
            }

            <button class="remote-button logout-button"
                    @onclick="Logout"
                    disabled="@IsBusy">
                خروج از حساب اپراتور
            </button>
        }
    </div>
</div>

