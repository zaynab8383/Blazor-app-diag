@page "/diagnostic-tcp"
@rendermode InteractiveServer

@using MyBlazorApp1.Services

@implements IDisposable

@inject DiagnosticMenuService MenuService
@inject DiagnosticTcpServerService TcpServer
@inject DiagnosticService DiagnosticService

<PageTitle>Diagnostic TCP Server</PageTitle>

<h3>Diagnostic TCP Server</h3>

<div class="mb-3">

    <p>
        <strong>Server:</strong>

        @if (TcpServer.IsRunning)
        {
            <span style="color:green;">
                Running
            </span>
        }
        else
        {
            <span style="color:red;">
                Stopped
            </span>
        }
    </p>

    <p>
        <strong>Client:</strong>

        @if (TcpServer.IsClientConnected)
        {
            <span style="color:green;">
                Connected
            </span>
        }
        else
        {
            <span style="color:red;">
                Disconnected
            </span>
        }
    </p>

    @if (!string.IsNullOrWhiteSpace(TcpServer.ClientEndPoint))
    {
        <p>
            <strong>Client Address:</strong>
            @TcpServer.ClientEndPoint
        </p>
    }

</div>

<div class="mb-3">

    <button class="btn btn-success me-2"
            @onclick="StartServer"
            disabled="@TcpServer.IsRunning">

        Start Server

    </button>

    <button class="btn btn-danger"
            @onclick="StopServer"
            disabled="@(!TcpServer.IsRunning)">

        Stop Server

    </button>

</div>

<hr />

<h4>TCP Log</h4>

<div style="
    height:450px;
    overflow-y:auto;
    background:#111;
    color:#00ff00;
    padding:12px;
    font-family:monospace;
    font-size:14px;
    border-radius:6px;
    ">

    @if (logs.Count == 0)
    {
        <div>
            No data yet...
        </div>
    }
    else
    {
        @foreach (string log in logs)
        {
            <div>@log</div>
        }
    }

</div>

<div class="mt-3">

    <button class="btn btn-secondary"
            @onclick="ClearLogs">

        Clear Log

    </button>

</div>


@code
{
    private readonly List<string> logs = new();


    protected override void OnInitialized()
    {
        TcpServer.LogReceived += OnLogReceived;
    }


    private async Task StartServer()
    {
        try
        {
            await TcpServer.StartAsync(9000);
            DiagnosticService.Start();

            AddLog(
                "DiagnosticService started.");
        }
        catch (Exception ex)
        {
            AddLog(
                $"START ERROR: {ex.Message}");
        }

        await InvokeAsync(
            StateHasChanged);
    }


    private void StopServer()
    {
        DiagnosticService.Stop();
        TcpServer.Stop();

        AddLog(
            "DiagnosticService stopped.");

        _ = InvokeAsync(
            StateHasChanged);
    }


    private void OnLogReceived(
        string message)
    {
        AddLog(message);
    }


    private void AddLog(
        string message)
    {
        logs.Add(message);

        if (logs.Count > 1000)
        {
            logs.RemoveAt(0);
        }

        _ = InvokeAsync(
            StateHasChanged);
    }


    private void ClearLogs()
    {
        logs.Clear();

        _ = InvokeAsync(
            StateHasChanged);
    }


    public void Dispose()
    {
        TcpServer.LogReceived -= OnLogReceived;
    }
}

